{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "BALANCE_REPORT=1 vitest run --reporter=default src/game/balance.report.test.ts",
    "m2-gate": "M2_ACCEPTANCE=1 vitest run --reporter=default src/game/m2gate.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "playtest:p0": "node scripts/playtest-p0.mjs",
    "playtest:m2": "node scripts/playtest-m2.mjs",
    "phone-check": "node scripts/phone-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}

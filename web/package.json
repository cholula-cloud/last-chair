{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ci:fast": "vitest run --exclude 'src/game/balance.test.ts' --exclude 'src/game/m3Determinism.test.ts'",
    "test:ci:slow": "vitest run src/game/balance.test.ts src/game/m3Determinism.test.ts",
    "test:watch": "vitest",
    "balance": "BALANCE_REPORT=1 vitest run --reporter=default src/game/balance.report.test.ts",
    "m2-gate": "M2_ACCEPTANCE=1 vitest run --reporter=default src/game/m2gate.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:assets && npm run build",
    "playtest:p0": "node scripts/playtest-p0.mjs",
    "playtest:smoke": "node scripts/playtest-smoke.mjs",
    "playtest:accessibility": "node scripts/playtest-accessibility.mjs",
    "playtest:feel": "node scripts/playtest-feel.mjs",
    "playtest:layers": "node scripts/playtest-layers.mjs",
    "playtest:coach": "node scripts/playtest-coach.mjs",
    "playtest:m2": "node scripts/playtest-m2.mjs",
    "playtest:snow-gun": "node scripts/playtest-snow-gun.mjs",
    "playwright:install": "playwright install chromium",
    "phone-check": "node scripts/phone-check.mjs",
    "screenshots:b6": "node scripts/screenshots-b6.mjs",
    "screenshots:b7": "node scripts/screenshots-b7.mjs",
    "screenshots:p4": "node scripts/screenshots-p4.mjs",
    "screenshots:snow30": "node scripts/screenshots-snow30.mjs",
    "screenshots:juice33": "node scripts/screenshots-juice33.mjs",
    "screenshots:o4": "node scripts/screenshots-o4.mjs",
    "screenshots:o5": "node scripts/screenshots-o5.mjs",
    "playtest:p1": "node scripts/playtest-p1.mjs",
    "replay": "node scripts/replay.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
